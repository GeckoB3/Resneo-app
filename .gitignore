# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Local env files, and any stray copy of one.
#
# `.env*.local` alone matched `.env.local` but NOT `.env.local.bak`, so a backup
# made while publishing an update was picked up by `requireCommit` and committed.
# Match the whole family instead, and allow only the checked-in template through.
.env*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local read-only reference clone of the web app
_reference/

# Firebase Android client config. Contains a Google API key; this repo is PUBLIC.
# Supplied to EAS builds as a file-type env var instead of being committed.
google-services.json

# Build artifacts downloaded from EAS (app.aab is ~110 MB). The build that
# matters lives on EAS and in the store listing, never in git.
*.aab
*.apk
*.ipa
