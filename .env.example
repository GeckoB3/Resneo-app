# Copy to .env.local and fill in values from your reserve-ni web project.
# Never commit .env.local — it is gitignored.

# Supabase project (same as reserve-ni)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Resneo web app URL — the reserve-ni backend (local dev or production)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Web dashboard origin for "Manage on web" link-outs. Defaults to
# EXPO_PUBLIC_API_URL when unset (single-host deploys).
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Optional: Sentry DSN. When set, the observability layer forwards errors to
# Sentry; unset = console-only. Requires the @sentry/react-native SDK
# (see lib/observability/index.ts for the activation checklist).
# EXPO_PUBLIC_SENTRY_DSN=

# Stripe PLATFORM publishable key (pk_test_/pk_live_) for in-person payments
# (Stripe Terminal / Tap to Pay). Same value as the web app's
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY. Optional: when unset, the in-person
# payment surface simply does not initialise.
# MUST match the mode of the backend this build talks to: a pk_test_ key against
# a server holding live Stripe secrets fails when minting a connection token.
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Card readers: 'true' discovers SIMULATED Stripe Terminal readers, 'false'
# discovers real hardware. Unset falls back to __DEV__ (simulated in a dev
# build, real in a release build).
#
# Set this to 'false' to pair a dev build with a real Tap to Pay phone or a
# WisePad 3 while keeping logs and fast refresh. In the dev-client workflow the
# JS comes from your local Metro, so THIS file is the lever, not eas.json.
# EXPO_PUBLIC_TERMINAL_SIMULATED=
