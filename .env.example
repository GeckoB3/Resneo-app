# Copy to .env.local and fill in values from your reserve-ni web project.
# Never commit .env.local — it is gitignored.

# Supabase project (same as reserve-ni)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Resneo web app URL — the reserve-ni backend (local dev or production)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Web dashboard origin for "Manage on web" link-outs. Defaults to
# EXPO_PUBLIC_API_URL when unset (single-host deploys).
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Optional: Sentry DSN. When set, the observability layer forwards errors to
# Sentry; unset = console-only. Requires the @sentry/react-native SDK
# (see lib/observability/index.ts for the activation checklist).
# EXPO_PUBLIC_SENTRY_DSN=
