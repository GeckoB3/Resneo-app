{
  "expo": {
    "name": "Resneo",
    "slug": "resneo-app",
    "version": "1.0.3",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "resneo",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/88e39a06-69cc-443e-ac83-71c24f35ea49"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.resneo.app",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "associatedDomains": [
        "applinks:www.resneo.com",
        "applinks:resneo.com",
        "applinks:reserve-ni.vercel.app"
      ],
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Resneo sends alerts when new bookings arrive or existing bookings change.",
        "NSFaceIDUsageDescription": "Resneo can use Face ID to lock the app so client records stay private if your phone is left unlocked.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "version": "1.0.0",
      "package": "com.resneo.app",
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "resneo"
            }
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "www.resneo.com"
            },
            {
              "scheme": "https",
              "host": "resneo.com"
            },
            {
              "scheme": "https",
              "host": "reserve-ni.vercel.app"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E8EFF6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#003B6F"
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#003B6F"
        }
      ],
      "expo-sharing",
      [
        "@sentry/react-native",
        {
          "organization": "resneo",
          "project": "react-native",
          "url": "https://de.sentry.io"
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "88e39a06-69cc-443e-ac83-71c24f35ea49"
      }
    },
    "owner": "resneo-app"
  }
}
