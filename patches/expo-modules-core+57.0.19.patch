+/**
+ resneo-app patch, for local Xcode 26.3 builds: holds the emitter weakly for the closures scheduled by
+ `emit`, exactly as the `nonisolated(unsafe) weak let` it replaces. Swift 6.2 drops that opt-out once
+ the closure rebinds it (`guard let emitter` - "sending emitter risks causing data races"); Swift 6.3
+ keeps it. The same reasoning about which state the closure touches applies unchanged.
+ */
+fileprivate struct UncheckedSendableWeakEmitter<Emitter: AnyObject>: @unchecked Sendable {
+  weak var emitter: Emitter?
+
+  init(_ emitter: Emitter) {
+    self.emitter = emitter
+  }
+}
