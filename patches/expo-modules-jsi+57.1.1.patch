+
+/// resneo-app patch, for local Xcode 26.3 builds: carries a call-scoped raw pointer into the
+/// nested `withGuaranteedContext` → `assumeIsolated` → `forwardingSwiftErrorsToJS` closures of
+/// the host-function trampolines. Swift 6.2 drops a `nonisolated(unsafe) let` local's opt-out
+/// once it is captured through nested closures ("sending 'resultPtr' risks causing data races");
+/// Swift 6.3 keeps it. A struct, so unlike `NonisolatedUnsafeVar` it adds no per-call allocation.
+internal struct UncheckedSendablePointer<Pointee>: @unchecked Sendable {
+  let pointer: Pointee
+
+  init(_ pointer: Pointee) {
+    self.pointer = pointer
+  }
+}
